# Shadowday agent backend. Copy to .env.local and fill in what you have.
# With no keys at all the app still works: every coworker falls back to scripted replies.
# Order of use: Groq first, then Gemini, then scripted.

# Groq (free tier). Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Set to 1 to skip the LLMs entirely and always use scripted replies (demos, offline, tests).
SHADOWDAY_SCRIPTED=0
